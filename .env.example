# LIMINAL environment template
# Copy to .env locally. Never commit real secrets.

ENV=development
DEBUG=false
ENABLE_DEBUG_ROUTES=false
HOST=127.0.0.1
PORT=8000

# Authentication
# Required in production; use at least 32 random characters.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
LIMINAL_TEST_USER_PASS=
LIMINAL_ADMIN_PASS=

# Data services
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
# Absolute host path containing operator-provisioned redis/ and elasticsearch/
# certificate directories; private keys are never committed to this repository.
LIMINAL_TLS_CERT_DIR=

# WebSocket limits
WS_MAX_CONNECTIONS=100
WS_MAX_CONNECTIONS_PER_IP=10
WS_RATE_LIMIT_PER_SECOND=10
WS_RATE_LIMIT_BURST=20
WS_MAX_MESSAGE_BYTES=16384
WS_MAX_CHANNEL_LENGTH=128
WS_MAX_CONTENT_LENGTH=8192
WS_MAX_TOKEN_LENGTH=8192

# Optional ML integration
ML_ENABLED=false
ML_SERVICE_URL=
# Shared only by the production core and its internal ML metrics consumer.
ML_METRICS_SERVICE_TOKEN=
OPENAI_API_KEY=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_SUCCESS_URL=http://127.0.0.1:8000/
STRIPE_CANCEL_URL=http://127.0.0.1:8000/
BILLING_STORE_PATH=

# Monitoring and production service credentials
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_PASSWORD=
ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
# Public loopback observability origin, without a trailing slash.
LIMINAL_OBSERVABILITY_BASE_URL=http://127.0.0.1:8080

# Production build base and service images must use immutable sha256 references.
PYTHON_IMAGE=python:3.11-slim@sha256:
REDIS_IMAGE_DIGEST=sha256:
NEO4J_IMAGE_DIGEST=sha256:
PROMETHEUS_IMAGE_DIGEST=sha256:
GRAFANA_IMAGE_DIGEST=sha256:
NGINX_IMAGE_DIGEST=sha256:
ELASTICSEARCH_IMAGE_DIGEST=sha256:
LOGSTASH_IMAGE_DIGEST=sha256:
KIBANA_IMAGE_DIGEST=sha256:

# Optional services are prebuilt separately and enabled only by adding their
# matching backend/production/docker-compose.*.yml override.
NEURAL_ANALYTICS_IMAGE_REPOSITORY=
NEURAL_ANALYTICS_IMAGE_DIGEST=sha256:
WEBSOCKET_GATEWAY_IMAGE_REPOSITORY=
WEBSOCKET_GATEWAY_IMAGE_DIGEST=sha256:
