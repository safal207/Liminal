# LIMINAL local development template
# Copy to .env locally. Never commit real secrets.

ENV=development
DEBUG=false
ENABLE_DEBUG_ROUTES=false
HOST=127.0.0.1
PORT=8000

# Authentication
# Required in production; use at least 32 random characters.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
LIMINAL_TEST_USER_PASS=
LIMINAL_ADMIN_PASS=

# Data services
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# WebSocket limits
WS_MAX_CONNECTIONS=100
WS_MAX_CONNECTIONS_PER_IP=10
WS_RATE_LIMIT_PER_SECOND=10
WS_RATE_LIMIT_BURST=20
WS_MAX_MESSAGE_BYTES=16384
WS_MAX_CHANNEL_LENGTH=128
WS_MAX_CONTENT_LENGTH=8192
WS_MAX_TOKEN_LENGTH=8192

# Optional ML integration
ML_ENABLED=false
ML_SERVICE_URL=
OPENAI_API_KEY=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_SUCCESS_URL=http://127.0.0.1:8000/
STRIPE_CANCEL_URL=http://127.0.0.1:8000/
BILLING_STORE_PATH=

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
